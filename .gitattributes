# Целевая ОС проекта — Linux, а разработка частично идёт на Windows.
# Без этого скрипты уедут в репозиторий с CRLF и не запустятся: bash споткнётся
# о \r в шебанге.
* text=auto eol=lf

*.sh    text eol=lf
*.kts   text eol=lf
*.kt    text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.json  text eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf

*.jar   binary
*.zip   binary
*.png   binary
