<idea-plugin>
    <id>dev.metajetcore.plugin</id>
    <name>MetaJetCore</name>
    <vendor>metajetcore</vendor>

    <description><![CDATA[
        Метаоркестратор Claude Code внутри JetBrains IDE.
        <br/><br/>
        Поднимает локальный MCP-сервер, через который сессия-оркестратор открывает рядом
        с собой вкладки с другими полноценными сессиями Claude Code — имплементером,
        ресерчером, ревьювером — и управляет их жизненным циклом.
        <br/><br/>
        Субагенты не используются: каждый агент это отдельный процесс со своим контекстом.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!--
      Зависимость на МОДУЛЬ плагина терминала, а не только на сам плагин.
      API переработанного терминала (TerminalToolWindowTabsManager, TerminalView) живёт в
      content-модуле `intellij.terminal.frontend` с visibility="public", и без этой строки
      classloader плагина его классов просто не видит — Class.forName вернёт null, и мы
      навсегда останемся в ручном режиме.

      Цена: зависимость обязательная, и при выключенном плагине терминала MetaJetCore не
      загрузится. Это осознанный размен — без терминала оркестрировать нечего. Мягкая
      деградация осталась там, где она нужна на самом деле: если API модуля изменится,
      рефлексия вернёт null и плагин перейдёт в ручной режим вместо падения.
    -->
    <dependencies>
        <plugin id="org.jetbrains.plugins.terminal"/>
        <module name="intellij.terminal.frontend"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <!--
          AgentManager и McpServerService объявлены аннотацией @Service(PROJECT) и здесь
          НЕ регистрируются: двойная регистрация — ошибка на современных платформах.
          MjcSettings аннотации не имеет (только @State), поэтому регистрируется тут.
        -->
        <applicationService serviceImplementation="dev.metajetcore.settings.MjcSettings"/>

        <applicationConfigurable
                parentId="tools"
                instance="dev.metajetcore.settings.MjcConfigurable"
                id="dev.metajetcore.settings"
                displayName="MetaJetCore"/>

        <postStartupActivity implementation="dev.metajetcore.MjcStartupActivity"/>

        <notificationGroup id="MetaJetCore" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="MetaJetCore.Menu" text="MetaJetCore" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="MetaJetCore.NewOrchestrator"
                    class="dev.metajetcore.actions.NewOrchestratorAction"
                    text="New Orchestrator Here"
                    description="Открыть вкладку с сессией Claude Code под управлением плагина"/>
            <action id="MetaJetCore.CopyMcpConfig"
                    class="dev.metajetcore.actions.CopyMcpConfigAction"
                    text="Copy MCP Config Command"
                    description="Скопировать команду claude mcp add для подключения оркестратора"/>
            <separator/>
            <action id="MetaJetCore.InstallSkill"
                    class="dev.metajetcore.actions.InstallSkillAction"
                    text="Reinstall Orchestrator Skill"
                    description="Переустановить ~/.claude/skills/orchestrate"/>
            <action id="MetaJetCore.Diagnostics"
                    class="dev.metajetcore.actions.DiagnosticsAction"
                    text="Diagnostics"
                    description="Какое терминальное API разрешилось и что вообще происходит"/>
        </group>
    </actions>
</idea-plugin>
